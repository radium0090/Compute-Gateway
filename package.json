{
  "name": "genchi",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source AI compute gateway",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "dev": "pnpm --filter @genchi/gateway dev",
    "docs:check": "tsx scripts/validate-docs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migrate": "pnpm --filter @genchi/gateway migrate",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "operations:check": "tsx scripts/validate-operations.ts",
    "start": "pnpm --filter @genchi/gateway start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@genchi/api-contract": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "openai": "7.3.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
