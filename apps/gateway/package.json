    "@rax-digital/config": "workspace:*",
    "@rax-digital/coordination-redis": "workspace:*",
    "@rax-digital/domain": "workspace:*",
    "@rax-digital/observability": "workspace:*",
    "@rax-digital/persistence-postgres": "workspace:*",
    "@rax-digital/provider-anthropic": "workspace:*",
    "@rax-digital/provider-gemini": "workspace:*",
    "@rax-digital/provider-openai": "workspace:*",
    "@rax-digital/router": "workspace:*",
    "fastify": "5.11.3",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.3",
    "tsx": "4.23.12"
  }
