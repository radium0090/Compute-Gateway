{
  "name": "@rax-digital/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "rax-compute-gateway": "./dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
