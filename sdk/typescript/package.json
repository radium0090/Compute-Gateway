{
  "name": "@genchi-ai/sdk",
  "version": "0.1.0",
  "description": "Thin TypeScript client for the Genchi API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "test": "vitest run --root ../.. --config vitest.config.ts sdk/typescript/src/client.test.ts"
  }
}
