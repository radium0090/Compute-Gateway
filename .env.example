# Development-only example values. Replace every value before production use.
GENCHI_ENVIRONMENT=development
GENCHI_DATABASE_URL=postgresql://genchi:genchi_dev_only@postgres:5432/genchi
GENCHI_MASTER_KEY=fake-local-master-key-change-before-use
GENCHI_KEY_HASH_PEPPER=fake-local-pepper-change-before-use-32-bytes
GENCHI_CONFIG_FILE=/etc/genchi/config.yaml
GENCHI_HOST=0.0.0.0
GENCHI_PORT=8080
GENCHI_LOG_LEVEL=info
GENCHI_REQUEST_BODY_LIMIT_BYTES=2097152
GENCHI_TOTAL_TIMEOUT_MS=60000
GENCHI_CONNECT_TIMEOUT_MS=5000
GENCHI_SHUTDOWN_GRACE_MS=30000
AUTH_CACHE_TTL_SECONDS=30
CONFIG_CACHE_TTL_SECONDS=15
GENCHI_TRUST_PROXY=false
GENCHI_METRICS_ENABLED=true
GENCHI_SERVICE_VERSION=0.0.0-dev
GENCHI_COMMIT_SHA=unknown
GENCHI_REDIS_URL=redis://redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Development placeholders only. Replace them to call a provider.
OPENAI_API_KEY=fake-openai-key-change-before-use
ANTHROPIC_API_KEY=fake-anthropic-key-change-before-use
GEMINI_API_KEY=fake-gemini-key-change-before-use
