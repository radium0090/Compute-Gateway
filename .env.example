# Development-only example values. Replace every value before production use.
RCG_ENVIRONMENT=development
POSTGRES_PASSWORD=rcg_dev_only
RCG_DATABASE_URL=postgresql://rcg:rcg_dev_only@postgres:5432/compute_gateway
RCG_MASTER_KEY=fake-local-master-key-change-before-use
RCG_KEY_HASH_PEPPER=fake-local-pepper-change-before-use-32-bytes
RCG_CONFIG_FILE=/etc/rax-compute-gateway/config.yaml
RCG_HOST=0.0.0.0
RCG_PORT=8080
RCG_LOG_LEVEL=info
RCG_REQUEST_BODY_LIMIT_BYTES=2097152
RCG_TOTAL_TIMEOUT_MS=60000
RCG_CONNECT_TIMEOUT_MS=30000
RCG_SHUTDOWN_GRACE_MS=30000
RCG_TRUST_PROXY=false
RCG_METRICS_ENABLED=true
RCG_ADMIN_ENABLED=true
RCG_ADMIN_ORIGIN=http://localhost:8080
RCG_ADMIN_SESSION_PEPPER=fake-local-admin-session-pepper-change-before-use
RCG_ADMIN_SESSION_TTL_MS=28800000
RCG_DEMO_ENABLED=false
RCG_DEMO_ORIGIN=http://localhost:8080
RCG_DEMO_MODEL=rax/fast
RCG_DEMO_KEY_TTL_MS=300000
RCG_DEMO_ACCOUNT_MINIMUM_AGE_DAYS=7
RCG_DEMO_ACCOUNT_COOLDOWN_MS=86400000
RCG_DEMO_MAXIMUM_DAILY_CLAIMS=50
RCG_DEMO_REQUESTS_PER_MINUTE=2
RCG_DEMO_MAX_REQUEST_TOKENS=2048
RCG_DEMO_MAX_OUTPUT_TOKENS=128
RCG_SERVICE_VERSION=0.0.0-dev
RCG_COMMIT_SHA=unknown
RCG_REDIS_URL=redis://redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Required only by the production Compose edge.
RCG_PUBLIC_HOST=api.example.com

# Development placeholders only. Replace them to call a provider.
OPENAI_API_KEY=fake-openai-key-change-before-use
ANTHROPIC_API_KEY=fake-anthropic-key-change-before-use
GEMINI_API_KEY=fake-gemini-key-change-before-use

# Required only when RCG_DEMO_ENABLED=true. Never commit real values.
RCG_DEMO_GITHUB_CLIENT_ID=fake-github-oauth-client-id
RCG_DEMO_GITHUB_CLIENT_SECRET=fake-github-oauth-client-secret
RCG_DEMO_HASH_PEPPER=fake-demo-identity-pepper-change-before-use
RCG_DEMO_TENANT_ID=123e4567-e89b-42d3-a456-426614174003
