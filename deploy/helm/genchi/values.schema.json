{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "existingSecret", "runtime", "policy"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": { "enum": ["latest"] }
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "existingSecret": { "type": "string", "minLength": 1 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "preStopDelaySeconds": { "type": "integer", "minimum": 0 },
    "runtime": {
      "type": "object",
      "required": [
        "environment",
        "totalTimeoutMs",
        "connectTimeoutMs",
        "shutdownGraceMs"
      ],
      "properties": {
        "environment": { "enum": ["staging", "production"] },
        "totalTimeoutMs": { "type": "integer", "minimum": 1000 },
        "connectTimeoutMs": { "type": "integer", "minimum": 1 },
        "shutdownGraceMs": { "type": "integer", "minimum": 1 }
      }
    },
    "policy": { "type": "object" }
  }
}
