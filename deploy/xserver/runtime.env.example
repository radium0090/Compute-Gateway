# Copy to /opt/rax-compute-gateway/shared/production.env on the VPS.
# Set mode 0600 and never commit the populated file.
POSTGRES_PASSWORD=replace-with-a-random-password
RCG_ENVIRONMENT=production
RCG_DATABASE_URL=postgresql://rcg:URL_ENCODED_PASSWORD@postgres:5432/compute_gateway
RCG_MASTER_KEY=replace-with-at-least-32-random-characters
RCG_KEY_HASH_PEPPER=replace-with-at-least-32-random-characters
RCG_CONFIG_FILE=/etc/rax-compute-gateway/config.yaml
RCG_HOST=0.0.0.0
RCG_PORT=8080
RCG_LOG_LEVEL=info
RCG_REQUEST_BODY_LIMIT_BYTES=2097152
RCG_TOTAL_TIMEOUT_MS=60000
RCG_CONNECT_TIMEOUT_MS=30000
RCG_SHUTDOWN_GRACE_MS=30000
# Trust only Caddy's address on the production Compose network.
RCG_TRUST_PROXY_CIDRS=10.249.254.2/32
RCG_METRICS_ENABLED=true
RCG_REDIS_URL=redis://redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

RCG_API_HOST=api.rax-digital.com
RCG_SITE_HOST=gateway.rax-digital.com
RCG_ADMIN_ENABLED=true
RCG_ADMIN_ORIGIN=https://api.rax-digital.com
RCG_ADMIN_SESSION_PEPPER=replace-with-an-independent-32-character-pepper
RCG_ADMIN_SESSION_TTL_MS=28800000

RCG_CONSOLE_ENABLED=true
RCG_CONSOLE_ORIGIN=https://gateway.rax-digital.com
RCG_CONSOLE_SESSION_PEPPER=replace-with-an-independent-32-character-pepper
RCG_CONSOLE_SESSION_TTL_MS=28800000
RCG_CONSOLE_REGISTRATION_ENABLED=false
RCG_CONSOLE_MAIL_FROM='RAX Compute Gateway <console@example.com>'
RCG_CONSOLE_RESEND_API_KEY=replace-after-verifying-the-sending-domain

RCG_DEMO_ENABLED=false
RCG_SERVICE_VERSION=0.4.0-production
RCG_COMMIT_SHA=unknown
RCG_IMAGE=rax-compute-gateway:production

OPENAI_API_KEY=replace-with-provider-key
ANTHROPIC_API_KEY=replace-with-provider-key
GEMINI_API_KEY=replace-with-provider-key
